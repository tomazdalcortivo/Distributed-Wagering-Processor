{
  "name": "distributed-wagering-processor",
  "version": "1.0.0",
  "description": "Jungle Gaming Technical Challenge — Distributed Financial Wagering Processor",
  "private": true,
  "scripts": {
    "build": "bun build ./src/main.ts --outdir ./dist --target bun",
    "typecheck": "tsc --noEmit",
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch run src/main.ts",
    "migration:up": "bun run src/infrastructure/database/cli/migrate.ts up",
    "migration:down": "bun run src/infrastructure/database/cli/migrate.ts down",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test test/concurrency",
    "test:load": "bun run test/load/load-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.658.1",
    "@mikro-orm/core": "^6.3.11",
    "@mikro-orm/migrations": "^6.3.11",
    "@mikro-orm/nestjs": "^6.0.2",
    "@mikro-orm/postgresql": "^6.3.11",
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/schedule": "^4.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.4",
    "@types/bun": "^1.1.30",
    "@types/node": "^20.16.10",
    "typescript": "^5.6.2"
  }
}
